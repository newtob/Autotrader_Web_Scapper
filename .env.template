# DATABASE_URL (required)
#
# Postgres connection URL for the Supabase transaction-mode pooler. Copy this file to .env
# (`cp .env.template .env`) and replace the placeholders. Never commit real values.
#
# Shape:
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres?sslmode=require
#
# - Use the transaction pooler (port 6543). sslmode=require is enforced: it is added
#   automatically for postgres URLs that do not set sslmode themselves.
# - Percent-encode special characters in the user/password (! is %21, @ is %40, % is %25);
#   they are decoded before connecting.
# - Accepted schemes: postgres://, postgresql:// (Supabase) and sqlite:/// (local testing only,
#   e.g. sqlite:///local.db).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres?sslmode=require
