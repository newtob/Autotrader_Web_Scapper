{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "prices": {
      "root": ".",
      "entrypoint": "api/prices.rs",
      "functions": { "api/prices.rs": { "maxDuration": 10 } }
    },
    "searches": {
      "root": ".",
      "entrypoint": "api/searches.rs",
      "functions": { "api/searches.rs": { "maxDuration": 10 } }
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/prices", "destination": { "service": "prices" } },
    { "source": "/api/searches", "destination": { "service": "searches" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
